# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Flask Secret Key for Session Security (Generate a random 32+ character string)
FLASK_SECRET_KEY=dev-secret-key-change-in-production-super-secret-random-hex-string

# Server configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
